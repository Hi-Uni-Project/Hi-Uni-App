\ud68c\uc6d0\uc740 \ub2e4\uc74c \uac01 \ud638\uc758 \ud589\uc704\ub97c \ud558\uc5ec\uc11c\ub294 \uc548 \ub429\ub2c8\ub2e4.\n\n1. \uac00\uc785 \uc2e0\uccad \ub610\ub294 \uc815\ubcf4 \ubcc0\uacbd \uc2dc \ud5c8\uc704 \uc0ac\uc2e4\uc744 \uae30\uc7ac\ud558\ub294 \ud589\uc704\n2. \ud0c0\uc778\uc758 \uac1c\uc778\uc815\ubcf4\ub97c \ubb34\ub2e8\uc73c\ub85c \uc218\uc9d1, \uc800\uc7a5, \uacf5\uac1c, \uc720\ud3ec\ud558\ub294 \ud589\uc704\n3. \ud68c\uc0ac \ub610\ub294 \uc81c3\uc790\uc758 \uc9c0\uc2dd\uc7ac\uc0b0\uad8c\uc744 \uce68\ud574\ud558\ub294 \ud589\uc704\n4. \uc695\uc124, \ube44\ubc29, \ucc28\ubcc4, \ud610\uc624, \ubd88\ubc95\uc801 \uac8c\uc2dc\ubb3c \uc791\uc131 \ub4f1 \ucee4\ubba4\ub2c8\ud2f0 \uc9c8\uc11c\ub97c \ud574\uce58\ub294 \ud589\uc704 \n5. \uc11c\ube44\uc2a4 \uc6b4\uc601\uc744 \ubc29\ud574\ud558\uac70\ub098 \uc548\uc815\uc131\uc744 \ud574\uce58\ub294 \ud589\uc704\n6. \uad00\ub828 \ubc95\ub839 \ubc0f \ubcf8 \uc57d\uad00\uc5d0 \uc704\ubc18\ub418\ub294 \ud589\uc704\n\n**\uc81c5\uc870 (\uc774\uc6a9 \uc81c\ud55c \ubc0f \uacc4\uc57d \ud574\uc9c0)**\n\n1. \ud68c\uc0ac\ub294 \ud68c\uc6d0\uc774 \ubcf8 \uc57d\uad00\uc744 \uc704\ubc18\ud558\uac70\ub098, \uc11c\ube44\uc2a4 \uc6b4\uc601\uc744 \uace0\uc758 \ub610\ub294 \uc911\uacfc\uc2e4\ub85c \ubc29\ud574\ud55c \uacbd\uc6b0 \uc0ac\uc804 \ud1b5\ubcf4 \uc5c6\uc774 \uc11c\ube44\uc2a4 \uc774\uc6a9\uc744 \uc81c\ud55c\ud558\uac70\ub098 \uc774\uc6a9\uacc4\uc57d\uc744 \ud574\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n2. \ud68c\uc0ac\ub294 \ud544\uc694\ud55c \uacbd\uc6b0 \uc704\ubc18 \ud589\uc704\uc758 \uc99d\uac70\ub97c \ubcf4\uc874\ud558\uace0, \uad00\uacc4 \ubc95\ub839\uc5d0 \ub530\ub77c \uad00\uacc4\uae30\uad00\uc5d0 \uc2e0\uace0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**\uc81c6\uc870 (\uba74\ucc45 \uc870\ud56d)**\n\n\ud68c\uc0ac\ub294 \ucc9c\uc7ac\uc9c0\ubcc0, \ubd88\uac00\ud56d\ub825\uc801 \uc0ac\uc720, \uc774\uc6a9\uc790\uc758 \uadc0\ucc45\uc0ac\uc720\ub85c \uc778\ud55c \uc11c\ube44\uc2a4 \uc774\uc6a9 \uc7a5\uc560\uc5d0 \ub300\ud558\uc5ec \ucc45\uc784\uc744 \uc9c0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."},{key:'privacy',type:'required',title:'\uac1c\uc778\uc815\ubcf4 \uc218\uc9d1 \ubc0f \uc774\uc6a9 \ub3d9\uc758\uc11c',description:"\n**1. \uc218\uc9d1 \ud56d\ubaa9**\n\n- \ud559\uad50\uba85, \ud559\uacfc\uba85, \ud559\uad50 \uc774\uba54\uc77c, \ub2c9\ub124\uc784, \uc544\uc774\ub514, \ube44\ubc00\ubc88\ud638\n- \uc790\ub3d9 \uc218\uc9d1: \uc811\uc18d \ub85c\uadf8, IP \uc815\ubcf4, \uae30\uae30 \uc815\ubcf4\n\n**2. \uc218\uc9d1 \ubaa9\uc801**\n\n- \ub300\ud559\uc0dd \uc778\uc99d \uae30\ubc18 \ucee4\ubba4\ub2c8\ud2f0 \uc11c\ube44\uc2a4 \uc81c\uacf5\n- \ucee4\ub9ac\uc5b4 \uc131\uc7a5 \uad00\ub828 \uac8c\uc2dc\ud310, \uc2a4\ud130\ub514 \ub9e4\uce6d, \uc815\ubcf4 \uc81c\uacf5\n- \uc778\ud134, \uc790\uaca9\uc99d, \uacf5\ubaa8\uc804 \ub4f1 \ucee4\ub9ac\uc5b4 \ucd94\ucc9c \uc11c\ube44\uc2a4 \uc81c\uacf5\n- \uc774\uc6a9\uc790 \uac04 \uc18c\ud1b5 \ubc0f \ub124\ud2b8\uc6cc\ud0b9 \uae30\ub2a5 \uc81c\uacf5\n- \ubd80\uc815\uc774\uc6a9 \ubc29\uc9c0 \ubc0f \uc11c\ube44\uc2a4 \uc548\uc804\uc131 \ud655\ubcf4\n\n**3. \ubcf4\uc720 \ubc0f \uc774\uc6a9 \uae30\uac04**\n\n- \uc6d0\uce59\uc801\uc73c\ub85c \ud68c\uc6d0 \ud0c8\ud1f4 \uc2dc \uc9c0\uccb4 \uc5c6\uc774 \ud30c\uae30\n- \ub2e8, \uad00\ub828 \ubc95\ub839\uc5d0 \ub530\ub77c \ubcf4\uc874\uc774 \ud544\uc694\ud55c \uacbd\uc6b0 \uc544\ub798 \uae30\uac04 \ub3d9\uc548 \ubcf4\uad00\n    - \uacc4\uc57d \ub610\ub294 \uccad\uc57d\ucca0\ud68c \ub4f1\uc5d0 \uad00\ud55c \uae30\ub85d: 5\ub144\n    - \ub300\uae08 \uacb0\uc81c \ubc0f \uc7ac\ud654 \ub4f1\uc758 \uacf5\uae09\uc5d0 \uad00\ud55c \uae30\ub85d: 5\ub144\n    - \uc18c\ube44\uc790 \ubd88\ub9cc \ub610\ub294 \ubd84\uc7c1 \ucc98\ub9ac\uc5d0 \uad00\ud55c \uae30\ub85d: 3\ub144\n\n**4. \ub3d9\uc758\ub97c \uac70\ubd80\ud560 \uad8c\ub9ac**\n\n- \uc774\uc6a9\uc790\ub294 \uac1c\uc778\uc815\ubcf4 \uc81c\uacf5 \ubc0f \uc774\uc6a9\uc5d0 \ub300\ud55c \ub3d9\uc758\ub97c \uac70\ubd80\ud560 \uad8c\ub9ac\uac00 \uc788\uc73c\uba70, \ub2e4\ub9cc \uc774 \uacbd\uc6b0 \uc11c\ube44\uc2a4 \uc81c\uacf5\uc774 \uc81c\ud55c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n"},{key:'marketing',type:'optional',title:'\ub9c8\ucf00\ud305 \uc815\ubcf4 \uc218\uc2e0 \ub3d9\uc758',description:"\n- \ud68c\uc0ac\ub294 \uc774\uc6a9\uc790\uc5d0\uac8c \uc774\ubca4\ud2b8, \uc2e0\uaddc \uc11c\ube44\uc2a4, \uc5c5\ub370\uc774\ud2b8 \uc18c\uc2dd, \uae30\ud0c0 \uad11\uace0\uc131 \uc815\ubcf4\ub97c \uc774\uba54\uc77c, \uc571 \ud478\uc2dc \ub4f1 \ub2e4\uc591\ud55c \uc218\ub2e8\uc744 \ud1b5\ud574 \ubc1c\uc1a1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \uc774\uc6a9\uc790\ub294 \uc5b8\uc81c\ub4e0\uc9c0 \uc218\uc2e0 \ub3d9\uc758\ub97c \ucca0\ud68c\ud560 \uc218 \uc788\uc73c\uba70, \ucca0\ud68c \ubc29\ubc95\uc740 \uc571 \ub0b4 \uc124\uc815\uc744 \ud1b5\ud574 \uac00\ub2a5\ud569\ub2c8\ub2e4.\n"},{key:'data',type:'optional',title:'\uc11c\ube44\uc2a4 \uac1c\uc120\uc744 \uc704\ud55c \ub370\uc774\ud130 \uc218\uc9d1 \ub3d9\uc758',description:"\n- \ud68c\uc0ac\ub294 \uc11c\ube44\uc2a4 \uac1c\uc120\uc744 \uc704\ud574 \uc774\uc6a9\uc790\uc758 \uc11c\ube44\uc2a4 \uc774\uc6a9 \ub370\uc774\ud130\ub97c \uc218\uc9d1\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \uc218\uc9d1\ub41c \ub370\uc774\ud130\ub294 \uc11c\ube44\uc2a4 \uac1c\uc120 \ubc0f \uc2e0\uaddc \uc11c\ube44\uc2a4 \uac1c\ubc1c\uc5d0 \ud65c\uc6a9\ub429\ub2c8\ub2e4.\n"},{key:'identity',type:'required',title:'\ubcf8\uc778 \uba85\uc758\ub97c \uc774\uc6a9\ud558\uc5ec \uac00\uc785\uc744 \uc9c4\ud589\ud569\ub2c8\ub2e4.',description:"\n- Hi-Uni(\ud558\uc774\uc720\ub2c8)\u201d\ub294 \uc548\uc804\ud558\uace0 \uc2e0\ub8b0\uc788\ub294 \ub300\ud559\uc0dd \ucee4\ub9ac\uc5b4 \uc131\uc7a5 \ucee4\ubba4\ub2c8\ud2f0\ub97c \uc704\ud574 \uac00\uc785 \uc2dc \uc6f9\uba54\uc77c\uc744 \ud65c\uc6a9\ud55c \ucca0\uc800\ud55c \ud559\uad50\uc778\uc99d\uc744 \ud1b5\ud574 \uc7ac\ud559 \uc5ec\ubd80\ub97c \ud655\uc778\ud569\ub2c8\ub2e4. \uc815\ubcf4\uac00 \uc77c\uce58\ud558\uc9c0 \uc54a\uc744 \uacbd\uc6b0 \uc11c\ube44\uc2a4\ub97c \uc774\uc6a9\ud558\uc2e4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4.\n    "}];e.default=n},2039,[]);
